{
  "name": "cc-trace-map",
  "version": "0.1.0",
  "description": "See what Claude Code and its helper agents are doing, in plain English: a live, local, interactive map of your sessions.",
  "license": "MIT",
  "keywords": [
    "claude-code",
    "claude",
    "agent",
    "observability",
    "visualization",
    "sub-agents",
    "explainer"
  ],
  "bin": {
    "cc-trace": "bin/cc-trace.mjs",
    "cc-trace-map": "bin/cc-trace.mjs"
  },
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    "!.next/standalone",
    "!.next/trace"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev --turbopack --port 4747",
    "build": "next build",
    "start": "node bin/cc-trace.mjs",
    "lint": "eslint",
    "check": "node --no-warnings --experimental-strip-types scripts/route.check.mts && node --no-warnings --experimental-strip-types scripts/stats.check.mts && node --no-warnings --experimental-strip-types scripts/session.check.mts",
    "prepublishOnly": "pnpm check && pnpm build",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-virtual": "3.14.21",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "9.0.0",
    "framer-motion": "^14.9.0",
    "lucide-react": "^1.66.0",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.17.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chehansivaruban/cc-trace.git"
  },
  "homepage": "https://github.com/chehansivaruban/cc-trace",
  "bugs": {
    "url": "https://github.com/chehansivaruban/cc-trace/issues"
  }
}
